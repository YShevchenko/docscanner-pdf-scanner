{"screenId":"a8d7dbe7320440b0a084784524561e7d","projectId":"2256788051838612451","htmlContent":"<!DOCTYPE html>\n\n<html class=\"light\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Archive - Document Scanner</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            colors: {\n              \"on-surface-variant\": \"#474747\",\n              \"primary-container\": \"#313c4f\",\n              \"surface\": \"#f7f9fb\",\n              \"tertiary-fixed-dim\": \"#39485a\",\n              \"secondary-container\": \"#c5d6f0\",\n              \"outline-variant\": \"#c6c6c6\",\n              \"on-primary-fixed-variant\": \"#d8e3fb\",\n              \"error-container\": \"#ffdad6\",\n              \"error\": \"#ba1a1a\",\n              \"inverse-primary\": \"#bcc7de\",\n              \"surface-container-high\": \"#e6e8ea\",\n              \"secondary-fixed-dim\": \"#9cacc5\",\n              \"on-primary\": \"#d8e3fb\",\n              \"on-tertiary\": \"#d4e4fa\",\n              \"surface-variant\": \"#e0e3e5\",\n              \"tertiary-fixed\": \"#516072\",\n              \"surface-container-highest\": \"#e0e3e5\",\n              \"primary-fixed\": \"#545f73\",\n              \"secondary\": \"#505f76\",\n              \"on-secondary-fixed-variant\": \"#2d3c51\",\n              \"on-surface\": \"#191c1e\",\n              \"surface-container-low\": \"#f2f4f6\",\n              \"on-error-container\": \"#410002\",\n              \"secondary-fixed\": \"#b7c8e1\",\n              \"on-secondary\": \"#ffffff\",\n              \"on-tertiary-fixed-variant\": \"#d4e4fa\",\n              \"tertiary\": \"#2e3c4e\",\n              \"on-background\": \"#191c1e\",\n              \"surface-tint\": \"#545f73\",\n              \"surface-dim\": \"#d8dadc\",\n              \"tertiary-container\": \"#677689\",\n              \"on-secondary-fixed\": \"#0b1c30\",\n              \"background\": \"#f7f9fb\",\n              \"inverse-surface\": \"#2d3133\",\n              \"on-primary-container\": \"#ffffff\",\n              \"primary-fixed-dim\": \"#3c475a\",\n              \"on-primary-fixed\": \"#ffffff\",\n              \"on-error\": \"#ffffff\",\n              \"surface-container-lowest\": \"#ffffff\",\n              \"on-tertiary-fixed\": \"#ffffff\",\n              \"primary\": \"#000000\",\n              \"on-secondary-container\": \"#0b1c30\",\n              \"outline\": \"#777777\",\n              \"on-tertiary-container\": \"#ffffff\",\n              \"surface-container\": \"#eceef0\",\n              \"surface-bright\": \"#f7f9fb\",\n              \"inverse-on-surface\": \"#eff1f3\"\n            },\n            fontFamily: {\n              \"headline\": [\"Manrope\"],\n              \"body\": [\"Inter\"],\n              \"label\": [\"Inter\"]\n            },\n            borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n          },\n        },\n      }\n    </script>\n<style>\n      .material-symbols-outlined {\n        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n      }\n      body {\n        font-family: 'Inter', sans-serif;\n      }\n      h1, h2, h3 {\n        font-family: 'Manrope', sans-serif;\n      }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-surface text-on-surface min-h-screen pb-32\">\n<!-- TopAppBar -->\n<header class=\"bg-slate-50 dark:bg-slate-950 w-full top-0 px-6 py-4 transition-all duration-300 ease-in-out\">\n<div class=\"flex justify-between items-center w-full max-w-screen-xl mx-auto\">\n<div class=\"flex items-center gap-4 flex-1\">\n<span class=\"material-symbols-outlined text-slate-900 dark:text-slate-50\" data-icon=\"search\">search</span>\n<input class=\"bg-transparent border-none focus:ring-0 font-body text-on-surface-variant w-full max-w-xs\" placeholder=\"Search archive...\" type=\"text\"/>\n</div>\n<h1 class=\"font-manrope font-bold text-xl tracking-tight text-slate-900 dark:text-slate-50 absolute left-1/2 -translate-x-1/2\">Archive</h1>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-slate-900 dark:text-slate-50\" data-icon=\"more_vert\">more_vert</span>\n</div>\n</div>\n</header>\n<main class=\"max-w-screen-xl mx-auto px-6 pt-10\">\n<!-- Hero Stats Section (Asymmetric Editorial Style) -->\n<section class=\"mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6\">\n<div class=\"space-y-2\">\n<p class=\"font-label text-secondary text-sm tracking-widest uppercase\">Overview</p>\n<div class=\"flex items-baseline gap-4\">\n<span class=\"text-7xl font-headline font-extrabold text-primary tracking-tighter\">48</span>\n<span class=\"text-xl font-headline font-bold text-secondary\">Documents Archived</span>\n</div>\n</div>\n<div class=\"flex gap-4\">\n<button class=\"bg-surface-container-high px-5 py-2.5 rounded-xl font-label text-sm font-semibold hover:bg-surface-dim transition-colors\">\n                    Recent\n                </button>\n<button class=\"bg-surface-container-lowest px-5 py-2.5 rounded-xl font-label text-sm font-semibold text-outline transition-colors\">\n                    Folders\n                </button>\n</div>\n</section>\n<!-- Document Grid (Bento Style & Tonal Layers) -->\n<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8\">\n<!-- Document Card 1 -->\n<div class=\"group cursor-pointer\">\n<div class=\"aspect-[3/4] bg-surface-container-lowest rounded-xl overflow-hidden mb-4 transition-transform duration-300 group-hover:-translate-y-2 ring-1 ring-black/[0.03]\">\n<img alt=\"Tax 2026 Document\" class=\"w-full h-full object-cover grayscale opacity-90 group-hover:opacity-100 transition-opacity\" data-alt=\"Close-up of a neatly scanned professional tax document on high-quality paper with subtle shadows and clean monochromatic aesthetic\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCB8XMDQRqtIs4U0vzVRuocFBRo5ONgZ14_iTR5ypi9GKZZaBJodM8SbBgiZWqZ7ACqHhoxeJGRFBQlyhPiuH87mS0pSAjWkQAAMG6z1a5TujQ-g091VtA45ZrWcTTrswWHz3l5GwxLU9SU6Q-gmN6H7ja3UwBLMi89r3Lmcv_1W8MtrhkBprbV_ULVu3YmkPoUYrDeKmSH_VJoxKcZ5NAGkfy29hQTpqbiK8lQm9QqtKU3CZcQW6M_1DjdPcg1qGs0DosnP9UhDC4\"/>\n</div>\n<h3 class=\"font-headline font-bold text-lg text-on-surface mb-1\">Tax 2026</h3>\n<p class=\"font-body text-sm text-secondary tracking-tight\">March 14, 2024</p>\n</div>\n<!-- Document Card 2 -->\n<div class=\"group cursor-pointer\">\n<div class=\"aspect-[3/4] bg-surface-container-lowest rounded-xl overflow-hidden mb-4 transition-transform duration-300 group-hover:-translate-y-2 ring-1 ring-black/[0.03]\">\n<img alt=\"Q1 Expenses\" class=\"w-full h-full object-cover grayscale opacity-90 group-hover:opacity-100 transition-opacity\" data-alt=\"A clean business form scan on a dark slate background, high contrast, editorial photography style with soft studio lighting\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBn2bPFIKXtFHFWGftyTt994tsoe-hFKXDACdSFGqLP154DT9h4jfA7Q9dZpm5-afghuRxUJL2bbxikOVAkI1dYg60oPPLQuhFeGZ1pxkr3gxVOuCozWuEolOSCnz9HCQjPcjWNboxLcl7VAiTI-AbddYRaTu-ogszm99yTew4FAoJYhPgJ5rRY2yJeVY6tY7JiEVqnZFIz-oN4ZD_Lp0Bxd6RgtH3af3m19tzmI2QDvFy27RhJ_u8AWMXqIbik5ZeuWmSEqAjiyz0\"/>\n</div>\n<h3 class=\"font-headline font-bold text-lg text-on-surface mb-1\">Q1 Expenses</h3>\n<p class=\"font-body text-sm text-secondary tracking-tight\">March 10, 2024</p>\n</div>\n<!-- Document Card 3 -->\n<div class=\"group cursor-pointer\">\n<div class=\"aspect-[3/4] bg-surface-container-lowest rounded-xl overflow-hidden mb-4 transition-transform duration-300 group-hover:-translate-y-2 ring-1 ring-black/[0.03]\">\n<img alt=\"Rental Agreement\" class=\"w-full h-full object-cover grayscale opacity-90 group-hover:opacity-100 transition-opacity\" data-alt=\"Legal contract document lying on a desk, monochromatic photography, focus on the typography and signature lines, minimalist\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuA57slKsYk7r9sw0ZwBKZh-xCsbHyUMi1r--0ywIJnyMPa95fUdqBGlIEJxiHAZB-C23yFTGT0MlWQKHxxpKIoc_sInJaS6PveNqKoApvnRPpjauYM5SMa1lWtVvQgiD5Cf13pZj9vwI8b555uxRKELRDwUB7G8J03mBgZvRvPnO4IEPHucEVYB2wTmO8Vd3_29ChoPhbAGJ4rwF3HRC9h8SdL9BqzPiHBIerck-MdrBg4XejLhqIIgUg4UeTJcouMHhQ7VZgTuG6c\"/>\n</div>\n<h3 class=\"font-headline font-bold text-lg text-on-surface mb-1\">Rental Agreement</h3>\n<p class=\"font-body text-sm text-secondary tracking-tight\">Feb 28, 2024</p>\n</div>\n<!-- Document Card 4 -->\n<div class=\"group cursor-pointer\">\n<div class=\"aspect-[3/4] bg-surface-container-lowest rounded-xl overflow-hidden mb-4 transition-transform duration-300 group-hover:-translate-y-2 ring-1 ring-black/[0.03]\">\n<img alt=\"Medical Form\" class=\"w-full h-full object-cover grayscale opacity-90 group-hover:opacity-100 transition-opacity\" data-alt=\"Clean medical intake form scan, soft gray tones, minimalist aesthetic with clear black text and professional layout\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAnZ9aK60jT0F31Z1S0VjjX3mjPD9hCACKS7ErNHVfCLCnYSXVrWpZwUv3og_MtZqIr8tFb5H707b7hzu0RSDTERn2bGu0myqUxrDzbyVy9xnTkkTTglv792TSRls5XBKFXZwsvk680s4Qsvqa_cOqLmi2lCb-iUtsDaNADdc67Zx6x4bn1TkgkIqlT7C8iKX_BiPTuMeaHKE35TS2mA9mI9GPHy6rdruTWotnqrFfysDYRnzc1C4jNqO9gs9b7n-FqPQi8yzA7f48\"/>\n</div>\n<h3 class=\"font-headline font-bold text-lg text-on-surface mb-1\">Medical Form</h3>\n<p class=\"font-body text-sm text-secondary tracking-tight\">Feb 15, 2024</p>\n</div>\n</div>\n</main>\n<!-- Floating Action Button (Glassmorphism) -->\n<div class=\"fixed bottom-32 right-8 z-[60]\">\n<button class=\"flex items-center justify-center w-20 h-20 rounded-full bg-primary text-on-primary shadow-[0_12px_32px_rgba(25,28,30,0.2)] hover:scale-105 active:scale-95 transition-all duration-200\">\n<span class=\"material-symbols-outlined text-4xl\" data-icon=\"photo_camera\">photo_camera</span>\n</button>\n</div>\n<!-- BottomNavBar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-8 pb-8 pt-4 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur-xl shadow-[0_-12px_32px_rgba(25,28,30,0.06)]\">\n<!-- Active Item (Grid View) -->\n<a class=\"flex flex-col items-center justify-center bg-slate-900 dark:bg-slate-50 text-slate-50 dark:text-slate-900 rounded-full w-12 h-12 transition-transform scale-110 active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"grid_view\" style=\"font-variation-settings: 'FILL' 1;\">grid_view</span>\n</a>\n<!-- Inactive Items -->\n<a class=\"flex flex-col items-center justify-center text-slate-400 dark:text-slate-600 w-12 h-12 hover:text-slate-900 dark:hover:text-slate-100 active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-slate-400 dark:text-slate-600 w-12 h-12 hover:text-slate-900 dark:hover:text-slate-100 active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"folder_open\">folder_open</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-slate-400 dark:text-slate-600 w-12 h-12 hover:text-slate-900 dark:hover:text-slate-100 active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\">settings</span>\n</a>\n</nav>\n</body></html>"}
