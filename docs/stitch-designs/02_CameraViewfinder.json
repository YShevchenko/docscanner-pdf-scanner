{"screenId":"3cf60b34407f415a9366185a9688b9e7","projectId":"2256788051838612451","htmlContent":"<!DOCTYPE html>\n\n<html class=\"light\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            colors: {\n              \"surface-bright\": \"#f7f9fb\",\n              \"inverse-on-surface\": \"#eff1f3\",\n              \"on-primary-container\": \"#ffffff\",\n              \"tertiary\": \"#2e3c4e\",\n              \"outline-variant\": \"#c6c6c6\",\n              \"secondary-fixed-dim\": \"#9cacc5\",\n              \"on-background\": \"#191c1e\",\n              \"surface-variant\": \"#e0e3e5\",\n              \"error\": \"#ba1a1a\",\n              \"on-error-container\": \"#410002\",\n              \"on-tertiary-fixed\": \"#ffffff\",\n              \"error-container\": \"#ffdad6\",\n              \"on-surface\": \"#191c1e\",\n              \"tertiary-container\": \"#677689\",\n              \"surface-container-lowest\": \"#ffffff\",\n              \"on-tertiary-container\": \"#ffffff\",\n              \"on-primary-fixed-variant\": \"#d8e3fb\",\n              \"tertiary-fixed-dim\": \"#39485a\",\n              \"on-tertiary-fixed-variant\": \"#d4e4fa\",\n              \"secondary\": \"#505f76\",\n              \"on-secondary-fixed\": \"#0b1c30\",\n              \"on-secondary-fixed-variant\": \"#2d3c51\",\n              \"tertiary-fixed\": \"#516072\",\n              \"secondary-fixed\": \"#b7c8e1\",\n              \"on-secondary\": \"#ffffff\",\n              \"surface-container-highest\": \"#e0e3e5\",\n              \"on-surface-variant\": \"#474747\",\n              \"surface-dim\": \"#d8dadc\",\n              \"inverse-surface\": \"#2d3133\",\n              \"surface-container-high\": \"#e6e8ea\",\n              \"secondary-container\": \"#c5d6f0\",\n              \"surface-tint\": \"#545f73\",\n              \"surface-container\": \"#eceef0\",\n              \"on-tertiary\": \"#d4e4fa\",\n              \"primary\": \"#000000\",\n              \"background\": \"#f7f9fb\",\n              \"primary-container\": \"#313c4f\",\n              \"outline\": \"#777777\",\n              \"on-secondary-container\": \"#0b1c30\",\n              \"on-error\": \"#ffffff\",\n              \"inverse-primary\": \"#bcc7de\",\n              \"surface\": \"#f7f9fb\",\n              \"primary-fixed\": \"#545f73\",\n              \"surface-container-low\": \"#f2f4f6\",\n              \"primary-fixed-dim\": \"#3c475a\",\n              \"on-primary-fixed\": \"#ffffff\",\n              \"on-primary\": \"#d8e3fb\"\n            },\n            fontFamily: {\n              \"headline\": [\"Manrope\"],\n              \"body\": [\"Inter\"],\n              \"label\": [\"Inter\"]\n            },\n            borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n          },\n        },\n      }\n    </script>\n<style>.material-symbols-outlined {\n    font-variation-settings: \"FILL\" 0, \"wght\" 400, \"GRAD\" 0, \"opsz\" 24\n    }\n.polygon-overlay {\n    clip-path: polygon(15% 10%, 85% 5%, 90% 90%, 10% 85%)\n    }\n.camera-container {\n    background-image: url(https://lh3.googleusercontent.com/aida-public/AB6AXuCXDWYF1YMIopkkmBbfpwP61XWIhaB1PWfPzvDzJ83L0O40mFaE33akqz0dQoro7Kf5lomD-r5nFEO7_AejIebA8yteBiTUBQCmEQkNwSkB6eeixhc-Q3AGtmyoIqcBj528I7bQQlaS3_Rn10rVZ4CJeLANUGcng0ijv1Bh-aoFDsCA9tRce0qS0HC11eOdea439agdyxD1D5Ual-ffSNa5NArTxrd-czl2LWxZdrhdELvPdjmsBsdz3SkURbR_DdgAMyZPONF_N0E);\n    background-size: cover;\n    background-position: center\n    }</style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-black font-body overflow-hidden h-screen w-screen flex flex-col\">\n<!-- TopAppBar Component (Shared) -->\n<header class=\"fixed top-0 w-full z-50 bg-slate-900/80 backdrop-blur-xl dark:bg-black/80 flex justify-between items-center px-6 py-4 w-full\">\n<button class=\"hover:opacity-80 transition-opacity active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-white\" data-icon=\"close\">close</span>\n</button>\n<h1 class=\"font-manrope font-bold text-lg tracking-tight text-white\">Scan</h1>\n<button class=\"hover:opacity-80 transition-opacity active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-white\" data-icon=\"flash_on\">flash_on</span>\n</button>\n</header>\n<!-- Main Viewfinder Area -->\n<main class=\"flex-1 relative camera-container\" data-alt=\"POV top-down view of a dark charcoal textured desk with a single white paper sheet being scanned by a smartphone\">\n<!-- Live Scan Polygon Overlay -->\n<div class=\"absolute inset-0 flex items-center justify-center p-12\">\n<div class=\"w-full h-full max-w-md max-h-[618px] relative\">\n<!-- Blue semi-transparent polygon simulating document detection -->\n<div class=\"absolute inset-0 bg-[#3b82f6]/30 border-2 border-[#3b82f6] polygon-overlay transition-all duration-700 ease-in-out backdrop-blur-[1px]\">\n<!-- Corner Indicators -->\n<div class=\"absolute top-0 left-0 w-4 h-4 border-t-4 border-l-4 border-white opacity-80\"></div>\n<div class=\"absolute top-0 right-0 w-4 h-4 border-t-4 border-r-4 border-white opacity-80\"></div>\n<div class=\"absolute bottom-0 left-0 w-4 h-4 border-b-4 border-l-4 border-white opacity-80\"></div>\n<div class=\"absolute bottom-0 right-0 w-4 h-4 border-b-4 border-r-4 border-white opacity-80\"></div>\n</div>\n<!-- Detection Label -->\n<div class=\"absolute -top-12 left-1/2 -translate-x-1/2 bg-white/10 backdrop-blur-md px-4 py-1.5 rounded-full flex items-center gap-2\">\n<span class=\"w-2 h-2 bg-[#3b82f6] rounded-full animate-pulse\"></span>\n<span class=\"text-white text-xs font-medium font-label uppercase tracking-widest\">Document Detected</span>\n</div>\n</div>\n</div>\n<!-- Archival Slider (Custom Component) -->\n<div class=\"absolute right-6 top-1/2 -translate-y-1/2 flex flex-col items-center gap-4\">\n<div class=\"h-48 w-1.5 bg-white/20 rounded-full relative overflow-hidden\">\n<div class=\"absolute bottom-0 w-full bg-white h-1/2\"></div>\n<div class=\"absolute bottom-1/2 left-1/2 -translate-x-1/2 translate-y-1/2 w-6 h-6 bg-white rounded-full shadow-xl ring-4 ring-white/10\"></div>\n</div>\n<span class=\"material-symbols-outlined text-white text-sm\" data-icon=\"exposure\">exposure</span>\n</div>\n</main>\n<!-- Bottom Interface Controls -->\n<div class=\"fixed bottom-0 w-full z-40 px-6 pb-40 pointer-events-none\">\n<div class=\"flex justify-center pointer-events-auto\">\n<!-- Mode Toggle (Segmented Control) -->\n<div class=\"bg-black/40 backdrop-blur-2xl p-1 rounded-full flex items-center border border-white/10\">\n<button class=\"px-6 py-1.5 rounded-full text-xs font-semibold font-label bg-white text-black transition-all\">Single</button>\n<button class=\"px-6 py-1.5 rounded-full text-xs font-semibold font-label text-white/60 hover:text-white transition-all\">Batch</button>\n</div>\n</div>\n</div>\n<!-- BottomNavBar Component (Shared/Modified for Viewfinder) -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-8 pb-8 bg-slate-900/80 backdrop-blur-xl dark:bg-black/80 h-32 rounded-t-3xl shadow-2xl\">\n<!-- Gallery Trigger -->\n<button class=\"flex flex-col items-center justify-center text-slate-300 w-12 h-12 hover:bg-slate-700 dark:hover:bg-slate-800 rounded-full transition-all\">\n<span class=\"material-symbols-outlined\" data-icon=\"photo_library\">photo_library</span>\n</button>\n<!-- Shutter Button -->\n<button class=\"flex flex-col items-center justify-center bg-white text-black rounded-full w-20 h-20 shadow-xl active:scale-90 duration-150 ease-in-out\">\n<div class=\"w-16 h-16 rounded-full border-2 border-black flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-4xl\" data-icon=\"radio_button_checked\">radio_button_checked</span>\n</div>\n</button>\n<!-- Layers/Filters Trigger -->\n<button class=\"flex flex-col items-center justify-center text-slate-300 w-12 h-12 hover:bg-slate-700 dark:hover:bg-slate-800 rounded-full transition-all\">\n<span class=\"material-symbols-outlined\" data-icon=\"layers\">layers</span>\n</button>\n</nav>\n<!-- Visual Polish: Subtle Grain Texture Overlay -->\n<div class=\"pointer-events-none fixed inset-0 opacity-[0.03] mix-blend-overlay bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]\"></div>\n</body></html>"}
