{"screenId":"d8e3153a38af4752872c7ef4b748498b","projectId":"2256788051838612451","htmlContent":"<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Obsidian Archive - Image Editor</title>\n<!-- Material Symbols -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Google Fonts -->\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    colors: {\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"background\": \"#f7f9fb\",\n                        \"surface-container\": \"#eceef0\",\n                        \"tertiary-fixed-dim\": \"#39485a\",\n                        \"tertiary\": \"#2e3c4e\",\n                        \"surface\": \"#f7f9fb\",\n                        \"primary-fixed\": \"#545f73\",\n                        \"inverse-on-surface\": \"#eff1f3\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"on-primary-container\": \"#ffffff\",\n                        \"on-tertiary-fixed\": \"#ffffff\",\n                        \"on-primary-fixed-variant\": \"#d8e3fb\",\n                        \"error-container\": \"#ffdad6\",\n                        \"on-tertiary-fixed-variant\": \"#d4e4fa\",\n                        \"on-primary-fixed\": \"#ffffff\",\n                        \"primary-fixed-dim\": \"#3c475a\",\n                        \"on-error\": \"#ffffff\",\n                        \"surface-container-low\": \"#f2f4f6\",\n                        \"secondary-fixed\": \"#b7c8e1\",\n                        \"on-secondary-fixed\": \"#0b1c30\",\n                        \"tertiary-fixed\": \"#516072\",\n                        \"surface-container-highest\": \"#e0e3e5\",\n                        \"error\": \"#ba1a1a\",\n                        \"outline-variant\": \"#c6c6c6\",\n                        \"secondary\": \"#505f76\",\n                        \"surface-container-high\": \"#e6e8ea\",\n                        \"on-surface\": \"#191c1e\",\n                        \"inverse-primary\": \"#bcc7de\",\n                        \"secondary-container\": \"#c5d6f0\",\n                        \"on-primary\": \"#d8e3fb\",\n                        \"tertiary-container\": \"#677689\",\n                        \"on-secondary-fixed-variant\": \"#2d3c51\",\n                        \"on-background\": \"#191c1e\",\n                        \"on-secondary-container\": \"#0b1c30\",\n                        \"surface-dim\": \"#d8dadc\",\n                        \"secondary-fixed-dim\": \"#9cacc5\",\n                        \"primary-container\": \"#313c4f\",\n                        \"on-tertiary-container\": \"#ffffff\",\n                        \"on-surface-variant\": \"#474747\",\n                        \"inverse-surface\": \"#2d3133\",\n                        \"surface-variant\": \"#e0e3e5\",\n                        \"surface-tint\": \"#545f73\",\n                        \"on-tertiary\": \"#d4e4fa\",\n                        \"primary\": \"#000000\",\n                        \"surface-bright\": \"#f7f9fb\",\n                        \"outline\": \"#777777\",\n                        \"on-error-container\": \"#410002\"\n                    },\n                    fontFamily: {\n                        \"headline\": [\"Manrope\"],\n                        \"body\": [\"Inter\"],\n                        \"label\": [\"Inter\"]\n                    },\n                    borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n                },\n            },\n        }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .perspective-container {\n            perspective: 1000px;\n        }\n        .crop-overlay {\n            clip-path: polygon(15% 10%, 85% 15%, 90% 85%, 10% 90%);\n            background: rgba(0, 0, 0, 0.2);\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background font-body text-on-surface overflow-hidden h-screen w-screen flex flex-col\">\n<!-- TopAppBar -->\n<header class=\"fixed top-0 w-full z-50 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur-md flex justify-between items-center px-6 py-4 w-full\">\n<button class=\"text-slate-500 dark:text-slate-400 font-manrope font-semibold text-lg hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors active:scale-95 duration-200\">\n            Cancel\n        </button>\n<h1 class=\"text-slate-900 dark:text-slate-50 font-manrope font-semibold text-lg\">\n            Edit Document\n        </h1>\n<button class=\"text-slate-900 dark:text-white font-bold font-manrope font-semibold text-lg hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors active:scale-95 duration-200\">\n            Done\n        </button>\n</header>\n<!-- Main Content: Editor Canvas -->\n<main class=\"flex-grow flex items-center justify-center px-6 pt-20 pb-32\">\n<div class=\"relative w-full max-w-md aspect-[3/4] bg-surface-container-low rounded-xl overflow-hidden shadow-[0_12px_32px_rgba(25,28,30,0.06)] flex items-center justify-center p-8\">\n<!-- The Captured Document -->\n<div class=\"relative w-full h-full\">\n<img alt=\"Captured document\" class=\"w-full h-full object-cover rounded-sm shadow-sm opacity-90 brightness-110\" data-alt=\"Close-up of a high-quality textured paper document with sharp black typography laying on a clean architectural slate surface\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCIhEb3wxFa8iH9QKl6RVoAqEaKoqin4faw6xjubE9K7Ku3hSLh16050rsR5g-gfqXix-R-cOCo44NyBgA-YfIIhMP07zTiPSz8IJlHRCbxh2AM90GkSfFCAvo_idVg1tFG0BD33cezGOyCCUAv4HZeu4dXz4QyjmRwxMBFRk-QYDMtK4RxCzVrm6SXlLvX43z5mgl47EAc3ytxGva-tKfbDeptRyIPf54K08KENcr3wFem52cvkvxiGEzJVQu-nV4MKdQMNvzEx0w\"/>\n<!-- Crop Interaction Layer -->\n<div class=\"absolute inset-0 z-10\">\n<!-- Semi-transparent overlay outside crop area -->\n<div class=\"absolute inset-0 bg-black/40\" style=\"clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 15% 10%, 10% 90%, 90% 85%, 85% 15%, 15% 10%);\"></div>\n<!-- Crop Border -->\n<div class=\"absolute inset-0 pointer-events-none\" style=\"clip-path: polygon(15% 10%, 85% 15%, 90% 85%, 10% 90%); border: 2px solid white;\"></div>\n<!-- Magnetic Crop Handles -->\n<!-- Top Left -->\n<div class=\"absolute top-[10%] left-[15%] -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-white rounded-full border-4 border-primary shadow-lg flex items-center justify-center\">\n<div class=\"w-1 h-1 bg-primary rounded-full\"></div>\n</div>\n<!-- Top Right -->\n<div class=\"absolute top-[15%] left-[85%] -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-white rounded-full border-4 border-primary shadow-lg flex items-center justify-center\">\n<div class=\"w-1 h-1 bg-primary rounded-full\"></div>\n</div>\n<!-- Bottom Right -->\n<div class=\"absolute top-[85%] left-[90%] -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-white rounded-full border-4 border-primary shadow-lg flex items-center justify-center\">\n<div class=\"w-1 h-1 bg-primary rounded-full\"></div>\n</div>\n<!-- Bottom Left -->\n<div class=\"absolute top-[90%] left-[10%] -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-white rounded-full border-4 border-primary shadow-lg flex items-center justify-center\">\n<div class=\"w-1 h-1 bg-primary rounded-full\"></div>\n</div>\n<!-- Crop Grid Lines -->\n<div class=\"absolute inset-0 opacity-30 pointer-events-none\" style=\"clip-path: polygon(15% 10%, 85% 15%, 90% 85%, 10% 90%);\">\n<div class=\"absolute top-1/3 left-0 w-full h-[1px] bg-white\"></div>\n<div class=\"absolute top-2/3 left-0 w-full h-[1px] bg-white\"></div>\n<div class=\"absolute left-1/3 top-0 h-full w-[1px] bg-white\"></div>\n<div class=\"absolute left-2/3 top-0 h-full w-[1px] bg-white\"></div>\n</div>\n</div>\n</div>\n<!-- Floating Label for Perspective -->\n<div class=\"absolute top-12 left-12 z-20 px-3 py-1 bg-primary/90 text-white text-[10px] uppercase tracking-widest font-bold rounded-full backdrop-blur-sm\">\n                Perspective Active\n            </div>\n</div>\n</main>\n<!-- BottomNavBar (Editor Tools) -->\n<!-- The user specifies specific icons: Rotate, Filter, Crop, Auto-Fix -->\n<nav class=\"fixed bottom-0 left-0 w-full bg-slate-100/90 dark:bg-slate-900/90 backdrop-blur-xl flex justify-around items-center px-8 py-6 pb-10 rounded-t-3xl z-50 shadow-[0_-4px_20px_rgba(0,0,0,0.05)]\">\n<!-- Rotate -->\n<button class=\"flex flex-col items-center gap-1 group text-slate-600 dark:text-slate-400 p-3 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-full transition-transform active:scale-90\">\n<span class=\"material-symbols-outlined text-[24px]\">rotate_right</span>\n<span class=\"font-inter text-[10px] tracking-wide font-medium opacity-0 group-hover:opacity-100 transition-opacity\">Rotate</span>\n</button>\n<!-- Filter -->\n<button class=\"flex flex-col items-center gap-1 group text-slate-600 dark:text-slate-400 p-3 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-full transition-transform active:scale-90\">\n<span class=\"material-symbols-outlined text-[24px]\">filter_vintage</span>\n<span class=\"font-inter text-[10px] tracking-wide font-medium opacity-0 group-hover:opacity-100 transition-opacity\">Filter</span>\n</button>\n<!-- Crop (Active) -->\n<button class=\"flex flex-col items-center gap-1 group bg-slate-900 dark:bg-slate-50 text-white dark:text-slate-900 rounded-full p-3 transition-transform active:scale-90\">\n<span class=\"material-symbols-outlined text-[24px]\">crop_rotate</span>\n<span class=\"font-inter text-[10px] tracking-wide font-bold\">Crop</span>\n</button>\n<!-- Auto-Fix -->\n<button class=\"flex flex-col items-center gap-1 group text-slate-600 dark:text-slate-400 p-3 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-full transition-transform active:scale-90\">\n<span class=\"material-symbols-outlined text-[24px]\">auto_fix_high</span>\n<span class=\"font-inter text-[10px] tracking-wide font-medium opacity-0 group-hover:opacity-100 transition-opacity\">Auto</span>\n</button>\n</nav>\n<!-- Contextual Editor Bar (Above Bottom Nav) -->\n<div class=\"fixed bottom-28 left-0 w-full px-6 z-40\">\n<div class=\"bg-surface-container-lowest/70 backdrop-blur-md rounded-2xl p-4 flex items-center justify-between shadow-sm border border-outline-variant/10\">\n<div class=\"flex items-center gap-4 overflow-x-auto no-scrollbar\">\n<div class=\"flex flex-col items-center gap-1\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container-highest flex items-center justify-center border-2 border-primary\">\n<span class=\"text-[10px] font-bold\">4:3</span>\n</div>\n<span class=\"text-[10px] text-slate-500 font-medium\">Free</span>\n</div>\n<div class=\"flex flex-col items-center gap-1\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center\">\n<span class=\"text-[10px] font-bold\">A4</span>\n</div>\n<span class=\"text-[10px] text-slate-400\">Fixed</span>\n</div>\n<div class=\"flex flex-col items-center gap-1\">\n<div class=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center\">\n<span class=\"text-[10px] font-bold\">1:1</span>\n</div>\n<span class=\"text-[10px] text-slate-400\">Square</span>\n</div>\n</div>\n<div class=\"h-10 w-[1px] bg-outline-variant/20 mx-2\"></div>\n<button class=\"flex items-center gap-2 px-4 py-2 bg-surface-container-high rounded-full hover:bg-surface-dim transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\">magic_button</span>\n<span class=\"text-xs font-semibold\">Magnetic</span>\n</button>\n</div>\n</div>\n</body></html>"}
