{"screenId":"c2ed0cbba85f48869e4ed806f83ca447","projectId":"2256788051838612451","htmlContent":"<!DOCTYPE html>\n\n<html class=\"light\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Receipt 01 - Obsidian Archive</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            colors: {\n              \"surface-container-lowest\": \"#ffffff\",\n              \"on-secondary\": \"#ffffff\",\n              \"on-tertiary\": \"#d4e4fa\",\n              \"on-primary-fixed\": \"#ffffff\",\n              \"surface-tint\": \"#545f73\",\n              \"secondary-fixed-dim\": \"#9cacc5\",\n              \"secondary-container\": \"#c5d6f0\",\n              \"on-secondary-fixed-variant\": \"#2d3c51\",\n              \"primary-fixed\": \"#545f73\",\n              \"surface-container-highest\": \"#e0e3e5\",\n              \"surface-variant\": \"#e0e3e5\",\n              \"on-surface\": \"#191c1e\",\n              \"inverse-primary\": \"#bcc7de\",\n              \"inverse-on-surface\": \"#eff1f3\",\n              \"surface-container-high\": \"#e6e8ea\",\n              \"secondary\": \"#505f76\",\n              \"on-primary-container\": \"#ffffff\",\n              \"error\": \"#ba1a1a\",\n              \"surface-container-low\": \"#f2f4f6\",\n              \"on-tertiary-fixed\": \"#ffffff\",\n              \"on-secondary-container\": \"#0b1c30\",\n              \"tertiary-container\": \"#677689\",\n              \"surface-bright\": \"#f7f9fb\",\n              \"on-primary\": \"#d8e3fb\",\n              \"secondary-fixed\": \"#b7c8e1\",\n              \"primary\": \"#000000\",\n              \"primary-container\": \"#313c4f\",\n              \"outline-variant\": \"#c6c6c6\",\n              \"on-secondary-fixed\": \"#0b1c30\",\n              \"error-container\": \"#ffdad6\",\n              \"surface-dim\": \"#d8dadc\",\n              \"inverse-surface\": \"#2d3133\",\n              \"on-surface-variant\": \"#474747\",\n              \"on-primary-fixed-variant\": \"#d8e3fb\",\n              \"on-tertiary-container\": \"#ffffff\",\n              \"on-error-container\": \"#410002\",\n              \"tertiary-fixed-dim\": \"#39485a\",\n              \"primary-fixed-dim\": \"#3c475a\",\n              \"surface-container\": \"#eceef0\",\n              \"tertiary-fixed\": \"#516072\",\n              \"on-tertiary-fixed-variant\": \"#d4e4fa\",\n              \"outline\": \"#777777\",\n              \"background\": \"#f7f9fb\",\n              \"tertiary\": \"#2e3c4e\",\n              \"on-error\": \"#ffffff\",\n              \"on-background\": \"#191c1e\",\n              \"surface\": \"#f7f9fb\"\n            },\n            fontFamily: {\n              \"headline\": [\"Manrope\"],\n              \"body\": [\"Inter\"],\n              \"label\": [\"Inter\"]\n            },\n            borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n          },\n        },\n      }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n            display: inline-block;\n            line-height: 1;\n            text-transform: none;\n            letter-spacing: normal;\n            word-wrap: normal;\n            white-space: nowrap;\n            direction: ltr;\n        }\n        .scrolling-touch {\n            -webkit-overflow-scrolling: touch;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-surface font-body text-on-surface selection:bg-secondary-container\">\n<!-- TopAppBar -->\n<header class=\"w-full top-0 sticky z-50 bg-[#f7f9fb] dark:bg-slate-900 flex items-center justify-between px-6 py-4\">\n<div class=\"flex items-center gap-4\">\n<button class=\"hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors active:scale-95 duration-200 p-2 rounded-full\">\n<span class=\"material-symbols-outlined text-slate-900 dark:text-slate-50\" data-icon=\"arrow_back\">arrow_back</span>\n</button>\n<h1 class=\"font-manrope font-semibold text-lg tracking-tight text-slate-900 dark:text-slate-50\">Receipt 01</h1>\n</div>\n<div class=\"flex items-center gap-2\">\n<button class=\"hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors active:scale-95 duration-200 p-2 rounded-full\">\n<span class=\"material-symbols-outlined text-slate-900 dark:text-slate-50\" data-icon=\"ios_share\">ios_share</span>\n</button>\n</div>\n</header>\n<!-- Main Content Area: The Canvas -->\n<main class=\"min-h-screen pb-32 pt-4 px-6 overflow-y-auto scrolling-touch bg-surface-container\">\n<!-- Document Metadata Header (Asymmetrical Editorial Style) -->\n<div class=\"mb-10 mt-4 max-w-md mx-auto\">\n<div class=\"flex flex-col space-y-1.5\">\n<span class=\"text-secondary font-label text-[11px] uppercase tracking-[0.15em] font-semibold\">Archived Document</span>\n<div class=\"flex justify-between items-baseline\">\n<h2 class=\"font-headline font-extrabold text-3xl text-on-surface tracking-tight\">Receipt 01</h2>\n<span class=\"font-body text-sm text-secondary/70\">Oct 24, 2023</span>\n</div>\n</div>\n</div>\n<!-- The \"Tactile\" Document Preview -->\n<div class=\"relative max-w-md mx-auto\">\n<!-- Ambient Luminosity Layering -->\n<div class=\"bg-surface-container-lowest rounded-sm shadow-[0_12px_32px_rgba(25,28,30,0.06)] p-1 relative z-10 overflow-hidden ring-1 ring-outline-variant/15\">\n<!-- High-quality scanned document image -->\n<img alt=\"Flattened high-contrast black and white receipt on a clean desk background with visible paper texture and sharp typography\" class=\"w-full h-auto rounded-sm grayscale contrast-125\" data-alt=\"sharp macro photo of a long grocery receipt on a white studio background with soft side lighting and paper texture\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAFZbq0a1IU_v28FRXzkp8Z7qp-uWJW0EBYlQBHy3atcRaVbrQAOJLD1hwOZFfZpmbmd1Cg8CNikIXzkFuz320SRUUef0AvhG8Ys4Avj5kQst4x1XswmGFElbQ0c5VM3ZtgknHD7xDTiQufvl241iRBfyi2uwQpb49o13bH9JPlVpi9i3nWT2D-4iEDG6dWOzZD5Jp2MqMIVI3QRNafNeKXw9hLSdd_0EsgK0YmMJTOl3kk-avjzgvt6O5LeTJ0-v48CU-wtxmUrxI\"/>\n<!-- Archival Overlay Details -->\n<div class=\"absolute top-4 right-4 bg-primary/80 backdrop-blur-md px-3 py-1 rounded-full border border-white/10\">\n<span class=\"text-[10px] font-label font-bold text-white tracking-widest uppercase\">Verified Scan</span>\n</div>\n</div>\n<!-- Visual Depth: Secondary Paper Layer -->\n<div class=\"absolute -bottom-3 -right-2 w-full h-full bg-surface-container-high rounded-sm -z-10 ring-1 ring-outline-variant/10\"></div>\n</div>\n<!-- Document Quick Stats / Bento-style Details -->\n<section class=\"mt-12 max-w-md mx-auto grid grid-cols-2 gap-4\">\n<div class=\"bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10\">\n<p class=\"text-[10px] font-label text-secondary uppercase tracking-widest mb-1\">Total Amount</p>\n<p class=\"font-headline font-bold text-xl text-on-surface\">$142.50</p>\n</div>\n<div class=\"bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10\">\n<p class=\"text-[10px] font-label text-secondary uppercase tracking-widest mb-1\">Vendor</p>\n<p class=\"font-headline font-bold text-xl text-on-surface\">Whole Foods</p>\n</div>\n<div class=\"col-span-2 bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10 flex items-center justify-between\">\n<div>\n<p class=\"text-[10px] font-label text-secondary uppercase tracking-widest mb-1\">Status</p>\n<p class=\"font-body font-semibold text-sm text-on-surface flex items-center gap-2\">\n<span class=\"w-2 h-2 rounded-full bg-primary\"></span>\n                        Digitized &amp; Indexed\n                    </p>\n</div>\n<span class=\"material-symbols-outlined text-secondary/40\" data-icon=\"inventory_2\">inventory_2</span>\n</div>\n</section>\n<!-- Spacer for Bottom Nav -->\n<div class=\"h-16\"></div>\n</main>\n<!-- BottomNavBar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-6 pb-8 pt-4 bg-white/80 dark:bg-slate-950/80 backdrop-blur-xl border-t border-slate-200/15 dark:border-slate-800/15 shadow-[0_-12px_32px_rgba(25,28,30,0.06)] rounded-t-2xl\">\n<!-- Add Page -->\n<button class=\"flex flex-col items-center justify-center text-slate-500 dark:text-slate-400 p-2 transition-all active:scale-90 duration-200 hover:text-slate-900 dark:hover:text-slate-50\">\n<span class=\"material-symbols-outlined mb-1\" data-icon=\"add_box\">add_box</span>\n<span class=\"font-inter text-[11px] font-medium tracking-wide uppercase\">Add Page</span>\n</button>\n<!-- OCR Text (Assuming active focus on processing/reading) -->\n<button class=\"flex flex-col items-center justify-center bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 rounded-xl px-4 py-2 transition-all active:scale-90 duration-200\">\n<span class=\"material-symbols-outlined mb-1\" data-icon=\"font_download\">font_download</span>\n<span class=\"font-inter text-[11px] font-medium tracking-wide uppercase\">OCR Text</span>\n</button>\n<!-- Delete -->\n<button class=\"flex flex-col items-center justify-center text-slate-500 dark:text-slate-400 p-2 transition-all active:scale-90 duration-200 hover:text-slate-900 dark:hover:text-slate-50\">\n<span class=\"material-symbols-outlined mb-1 text-error/80\" data-icon=\"delete\">delete</span>\n<span class=\"font-inter text-[11px] font-medium tracking-wide uppercase\">Delete</span>\n</button>\n</nav>\n</body></html>"}
