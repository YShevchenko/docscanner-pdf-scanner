{"screenId":"48f0eb92786741feac9bc4c247143e8b","projectId":"2256788051838612451","htmlContent":"<!DOCTYPE html>\n\n<html class=\"light\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Settings | Obsidian Archive</title>\n<!-- Fonts -->\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Icons -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    colors: {\n                        \"on-secondary\": \"#ffffff\",\n                        \"tertiary-fixed\": \"#516072\",\n                        \"background\": \"#f7f9fb\",\n                        \"inverse-on-surface\": \"#eff1f3\",\n                        \"tertiary-fixed-dim\": \"#39485a\",\n                        \"secondary\": \"#505f76\",\n                        \"on-tertiary\": \"#d4e4fa\",\n                        \"primary-fixed\": \"#545f73\",\n                        \"on-primary\": \"#d8e3fb\",\n                        \"secondary-fixed\": \"#b7c8e1\",\n                        \"surface\": \"#f7f9fb\",\n                        \"on-tertiary-fixed-variant\": \"#d4e4fa\",\n                        \"on-secondary-fixed-variant\": \"#2d3c51\",\n                        \"surface-container-low\": \"#f2f4f6\",\n                        \"on-surface-variant\": \"#474747\",\n                        \"on-background\": \"#191c1e\",\n                        \"surface-bright\": \"#f7f9fb\",\n                        \"primary\": \"#000000\",\n                        \"on-primary-container\": \"#ffffff\",\n                        \"outline\": \"#777777\",\n                        \"on-primary-fixed\": \"#ffffff\",\n                        \"inverse-primary\": \"#bcc7de\",\n                        \"tertiary-container\": \"#677689\",\n                        \"surface-variant\": \"#e0e3e5\",\n                        \"on-tertiary-container\": \"#ffffff\",\n                        \"surface-tint\": \"#545f73\",\n                        \"on-tertiary-fixed\": \"#ffffff\",\n                        \"surface-container-high\": \"#e6e8ea\",\n                        \"tertiary\": \"#2e3c4e\",\n                        \"outline-variant\": \"#c6c6c6\",\n                        \"on-secondary-container\": \"#0b1c30\",\n                        \"on-error\": \"#ffffff\",\n                        \"surface-container-highest\": \"#e0e3e5\",\n                        \"on-primary-fixed-variant\": \"#d8e3fb\",\n                        \"primary-fixed-dim\": \"#3c475a\",\n                        \"on-secondary-fixed\": \"#0b1c30\",\n                        \"error\": \"#ba1a1a\",\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"inverse-surface\": \"#2d3133\",\n                        \"secondary-container\": \"#c5d6f0\",\n                        \"surface-dim\": \"#d8dadc\",\n                        \"primary-container\": \"#313c4f\",\n                        \"secondary-fixed-dim\": \"#9cacc5\",\n                        \"on-surface\": \"#191c1e\",\n                        \"on-error-container\": \"#410002\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-container\": \"#eceef0\"\n                    },\n                    fontFamily: {\n                        \"headline\": [\"Manrope\"],\n                        \"body\": [\"Inter\"],\n                        \"label\": [\"Inter\"]\n                    },\n                    borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n                },\n            },\n        }\n    </script>\n<style>\n        body {\n            -webkit-tap-highlight-color: transparent;\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .ghost-border {\n            outline: 1px solid rgba(198, 198, 198, 0.15);\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-surface font-body text-on-surface min-h-screen pb-32\">\n<!-- TopAppBar -->\n<header class=\"w-full top-0 sticky bg-slate-50 dark:bg-slate-950 z-50\">\n<div class=\"flex items-center px-6 h-16 w-full max-w-none\">\n<button class=\"mr-4 active:opacity-70 transition-opacity flex items-center justify-center h-10 w-10 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors rounded-full\">\n<span class=\"material-symbols-outlined text-slate-900 dark:text-slate-50\" data-icon=\"arrow_back\">arrow_back</span>\n</button>\n<h1 class=\"font-manrope text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-50\">Settings</h1>\n</div>\n</header>\n<!-- Main Content -->\n<main class=\"max-w-xl mx-auto px-6 py-10 space-y-12\">\n<!-- Preferences Section -->\n<section class=\"space-y-4\">\n<h2 class=\"font-headline font-extrabold text-xs tracking-widest uppercase text-secondary/70 px-1\">Preferences</h2>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-[0_4px_20px_rgba(25,28,30,0.02)] overflow-hidden ghost-border\">\n<!-- Item: Default Export Quality -->\n<div class=\"flex items-center justify-between p-5 hover:bg-surface-container-low transition-colors group\">\n<div class=\"flex flex-col gap-0.5\">\n<span class=\"font-headline font-bold text-[15px]\">Default Export Quality</span>\n<span class=\"text-secondary text-sm font-medium\">Define resolution for archival exports</span>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"text-primary font-bold text-sm bg-surface-container-high px-3 py-1 rounded-full\">Lossless</span>\n<span class=\"material-symbols-outlined text-outline-variant text-[20px]\" data-icon=\"chevron_right\">chevron_right</span>\n</div>\n</div>\n<!-- Item: Dark Mode -->\n<div class=\"flex items-center justify-between p-5 hover:bg-surface-container-low transition-colors border-t border-surface-container/30\">\n<div class=\"flex flex-col gap-0.5\">\n<span class=\"font-headline font-bold text-[15px]\">Dark Mode</span>\n<span class=\"text-secondary text-sm font-medium\">Switch between light and charcoal interface</span>\n</div>\n<label class=\"relative inline-flex items-center cursor-pointer\">\n<input class=\"sr-only peer\" type=\"checkbox\" value=\"\"/>\n<div class=\"w-11 h-6 bg-surface-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary\"></div>\n</label>\n</div>\n</div>\n</section>\n<!-- Data Management Section -->\n<section class=\"space-y-4\">\n<h2 class=\"font-headline font-extrabold text-xs tracking-widest uppercase text-secondary/70 px-1\">Data Management</h2>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-[0_4px_20px_rgba(25,28,30,0.02)] overflow-hidden ghost-border\">\n<!-- Item: Clear Cache -->\n<button class=\"w-full flex items-center justify-between p-5 hover:bg-surface-container-low transition-colors active:scale-[0.99] transition-transform\">\n<div class=\"flex flex-col items-start gap-0.5\">\n<span class=\"font-headline font-bold text-[15px]\">Clear Cache</span>\n<span class=\"text-secondary text-sm font-medium\">Free up space by removing temporary assets</span>\n</div>\n<span class=\"material-symbols-outlined text-error/80\" data-icon=\"delete_sweep\">delete_sweep</span>\n</button>\n<!-- Item: Export All Data -->\n<button class=\"w-full flex items-center justify-between p-5 hover:bg-surface-container-low transition-colors border-t border-surface-container/30 active:scale-[0.99] transition-transform\">\n<div class=\"flex flex-col items-start gap-0.5\">\n<span class=\"font-headline font-bold text-[15px]\">Export All Data to JSON</span>\n<span class=\"text-secondary text-sm font-medium\">Generate a portable archive of your database</span>\n</div>\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"terminal\">terminal</span>\n</button>\n</div>\n</section>\n<!-- About Section -->\n<section class=\"space-y-4\">\n<h2 class=\"font-headline font-extrabold text-xs tracking-widest uppercase text-secondary/70 px-1\">About</h2>\n<div class=\"bg-surface-container-lowest rounded-xl shadow-[0_4px_20px_rgba(25,28,30,0.02)] overflow-hidden ghost-border\">\n<!-- Item: Version -->\n<div class=\"flex items-center justify-between p-5 border-b border-surface-container/30\">\n<span class=\"font-headline font-bold text-[15px]\">Version</span>\n<span class=\"text-secondary font-mono text-xs bg-surface-container px-2 py-1 rounded\">1.4.2</span>\n</div>\n<!-- Item: Terms -->\n<a class=\"flex items-center justify-between p-5 hover:bg-surface-container-low transition-colors border-b border-surface-container/30\" href=\"#\">\n<span class=\"font-headline font-bold text-[15px]\">Terms of Service</span>\n<span class=\"material-symbols-outlined text-outline-variant text-[20px]\" data-icon=\"open_in_new\">open_in_new</span>\n</a>\n<!-- Item: Privacy Policy -->\n<a class=\"flex items-center justify-between p-5 hover:bg-surface-container-low transition-colors\" href=\"#\">\n<span class=\"font-headline font-bold text-[15px]\">Privacy Policy</span>\n<span class=\"material-symbols-outlined text-outline-variant text-[20px]\" data-icon=\"policy\">policy</span>\n</a>\n</div>\n</section>\n<!-- Aesthetic Document Graphic (The Tactile Archivist) -->\n<div class=\"pt-8 flex flex-col items-center opacity-40\">\n<div class=\"w-24 h-32 bg-surface-container-highest rounded-sm shadow-inner flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-4xl text-outline-variant\" data-icon=\"inventory\">inventory</span>\n</div>\n<p class=\"mt-4 font-headline text-[10px] tracking-[0.2em] uppercase font-bold text-outline\">Digital Archive Management System</p>\n</div>\n</main>\n<!-- BottomNavBar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 pt-2 pb-6 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur-xl border-t border-slate-200/15 dark:border-slate-800/15 shadow-[0_-12px_32px_rgba(25,28,30,0.04)]\">\n<a class=\"flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 px-4 py-1.5 hover:text-slate-600 dark:hover:text-slate-300 active:scale-95 transition-transform duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"inventory_2\">inventory_2</span>\n<span class=\"font-inter text-[11px] font-medium tracking-wide uppercase mt-1\">Archive</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 px-4 py-1.5 hover:text-slate-600 dark:hover:text-slate-300 active:scale-95 transition-transform duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"search\">search</span>\n<span class=\"font-inter text-[11px] font-medium tracking-wide uppercase mt-1\">Search</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 px-4 py-1.5 hover:text-slate-600 dark:hover:text-slate-300 active:scale-95 transition-transform duration-200\" href=\"#\">\n<div class=\"bg-primary text-on-primary-container p-3 rounded-full -mt-10 shadow-lg shadow-primary/20\">\n<span class=\"material-symbols-outlined\" data-icon=\"center_focus_strong\" style=\"font-variation-settings: 'FILL' 1;\">center_focus_strong</span>\n</div>\n<span class=\"font-inter text-[11px] font-medium tracking-wide uppercase mt-1\">Scan</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-slate-900 dark:text-slate-50 bg-slate-200/50 dark:bg-slate-800/50 rounded-xl px-4 py-1.5 active:scale-95 transition-transform duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\" style=\"font-variation-settings: 'FILL' 1;\">settings</span>\n<span class=\"font-inter text-[11px] font-medium tracking-wide uppercase mt-1\">Settings</span>\n</a>\n</nav>\n</body></html>"}
